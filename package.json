{
  "name": "deepaltitude",
  "description": "Deep Altitude — a public notebook about physical practice, languages and thinking.",
  "dependencies": {
    "@astrojs/cloudflare": "12.6.12",
    "@astrojs/mdx": "4.3.13",
    "@astrojs/rss": "4.0.14",
    "@astrojs/sitemap": "3.6.1",
    "astro": "5.16.9",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "wrangler": "4.88.0"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "astro": "astro",
    "build": "astro build --force",
    "cf-typegen": "wrangler types",
    "check": "npm run build && node notebook/verify.mjs && tsc && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "astro dev",
    "preview": "npm run build && wrangler dev"
  },
  "type": "module"
}
