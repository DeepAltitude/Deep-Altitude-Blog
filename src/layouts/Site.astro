---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {htmlLang,type Edition} from '../utils/posts';
interface Props {title:string;description?:string;edition?:Edition;active?:string;canonical?:string;image?:string;article?:boolean;pubDate?:Date;updatedDate?:Date;versions?:{edition:Edition;href:string}[];class?:string;language?:string;noindex?:boolean}
const {edition='original',versions=[],language=htmlLang[edition],...props}=Astro.props;
---
<!doctype html>
<html lang={language}>
 <head><BaseHead {...props} alternates={versions.map(v=>({language:htmlLang[v.edition],href:v.href}))} />{Astro.props.noindex&&<meta name="robots" content="noindex"/>}</head>
 <body><Header edition={edition} active={Astro.props.active} versions={versions}/><main id="main" class={Astro.props.class}><slot /></main><Footer edition={edition}/></body>
</html>
