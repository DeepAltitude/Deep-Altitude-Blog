---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props {
  title: string;
  description?: string;
  active?: string;
  canonical?: string;
  image?: string;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  class?: string;
  language?: string;
  noindex?: boolean;
}
const { language = "lt", ...props } = Astro.props;
---

<!doctype html>
<html lang={language}>
  <head>
    <BaseHead {...props} />
    {Astro.props.noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <Header active={Astro.props.active} />
    <main id="main" class={Astro.props.class}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
<script>
  import "../scripts/notebook";
</script>
