---
import {render} from 'astro:content';
import Site from './Site.astro';
import {marked} from '../../notebook/vendor/marked.mjs';
import {getNotes,versionsFor,dateLabel,langLabel,bodyLanguage,indexUrl,copy,usableImage,type Note} from '../utils/posts';
import {labels} from '../utils/editorial';
interface Props {note:Note;canonical?:string}
const {note,canonical=note.url}=Astro.props,t=copy[note.edition],l=labels[note.edition];
const {Content}=await render(note.source);
const versions=await versionsFor(note),siblings=(await getNotes(note.edition)).filter(n=>n.category===note.category);
const position=siblings.findIndex(n=>n.id===note.id),previous=siblings[position+1],next=position>0?siblings[position-1]:undefined;
const image=usableImage(note.heroImage);
---
<Site title={note.title} description={note.description} edition={note.edition} active={note.category} canonical={canonical} versions={versions} image={image} article pubDate={note.pubDate} updatedDate={note.updatedDate} noindex={note.example}>
 <article class="reading-page">
  <header class="article-header"><p class="article-meta"><a href={indexUrl(note.edition,note.category)}>{note.category}</a><span aria-hidden="true">/</span><time datetime={note.pubDate.toISOString()}>{dateLabel(note.pubDate)}</time><span aria-hidden="true">/</span><span>{l.original}: {langLabel(note.originalLanguage)}</span></p><h1>{note.title}</h1>{note.description&&<p class="standfirst">{note.description}</p>}{note.updatedDate&&<p class="updated-date">{l.updated}: <time datetime={note.updatedDate.toISOString()}>{dateLabel(note.updatedDate)}</time></p>}</header>
  {image&&<figure class="article-hero"><img src={image} alt={note.heroImageAlt||''} decoding="async"/>{note.heroCaption&&<figcaption>{note.heroCaption}</figcaption>}</figure>}
  <div class="prose article-body" lang={bodyLanguage(note)}>{note.translated?<Fragment set:html={marked.parse(note.body,{gfm:true,breaks:true})}/>:<Content/>}</div>
  <div class="article-colophon">{note.translated&&<p>{t.translationNote} {note.stale&&l.older} <a href={versions.find(v=>v.edition==='original')?.href}>{t.viewOriginal} →</a></p>}
   {!note.translated&&<details class="raw-source"><summary>{t.raw}</summary><pre>{note.raw}</pre></details>}
   <a class="raw-download" href={`/original/files/${note.id}.md`} download>{t.download} ↓</a>
  </div>
  <nav class="page-turn" aria-label={t.notes}><a class="back-link" href={indexUrl(note.edition,note.category)}>← {note.category}</a><div class="adjacent-notes">{previous&&<a href={previous.url}><span>{l.previous}</span><strong>{previous.title}</strong></a>}{next&&<a class="next-note" href={next.url}><span>{l.next}</span><strong>{next.title}</strong></a>}</div></nav>
 </article>
</Site>
