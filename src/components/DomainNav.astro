---
import {copy,indexUrl,domainUrl,type Edition} from '../utils/posts';
import {domains,domainNames,type Domain} from '../utils/domains';
import {knowledgeLabels} from '../utils/knowledge-labels';
interface Props {edition?:Edition;active?:Domain;all?:boolean}
const {edition='original',active,all=false}=Astro.props;
---
<nav class="topic-nav" aria-label={knowledgeLabels[edition].domains}>
  <a href={indexUrl(edition)} aria-current={all?'page':undefined}>{copy[edition].all}</a>
  {domains.map(domain=><a href={domainUrl(domain,edition)} aria-current={active===domain?'page':undefined}>{domainNames[domain]}</a>)}
</nav>
