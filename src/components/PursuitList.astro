---
import { pursuitProgress } from "../lib/calendar/model";
interface Props { records: any[]; kind: "projects" | "experiments"; }
const {records,kind}=Astro.props,base=kind==="projects"?"/projektai/":"/eksperimentai/";
const fields=kind==="projects"?[["outcome","Desired outcome"],["description",""]]:[["description",""],["hypothesis","Hypothesis"],["protocol","Protocol"],["observe","What I observe"],["conclusion","Conclusion"]];
---
<ol class="article-index">
  {records.map(record=>(
    <li><details class="notebook-entry" data-operation data-kind={kind} data-id={record.id}>
      <summary class="index-entry"><div class="entry-meta">{record.status}</div><div class="entry-copy"><h3>{record.title}</h3>{pursuitProgress(record,kind)&&<p class="inline-progress">{pursuitProgress(record,kind)}</p>}</div><span class="entry-arrow" aria-hidden="true">⌄</span></summary>
      <div class="inline-content" data-operation-panel><div class="prose">{fields.map(([key,label])=>record[key]&&<Fragment>{label&&<h3>{label}</h3>}<p class="preserve-lines">{record[key]}</p></Fragment>)}</div>{(record.start_date||record.end_date)&&<p class="entry-tags">{record.start_date&&<>Start: {record.start_date.slice(0,10)}</>}{record.end_date&&<> · Target end: {record.end_date.slice(0,10)}</>}</p>}<a href={base+record.slug+"/"} class="quiet-link">Open {kind==="projects"?"project":"experiment"} →</a></div>
    </details></li>
  ))}
</ol>
