---
import {dateLabel,langLabel,type Note} from '../utils/posts';
interface Props {notes:Note[];numbered?:boolean}
const {notes,numbered=false}=Astro.props;
---
<ol class:list={['article-index',{'numbered':numbered}]}>
 {notes.map((note,i)=><li data-category={note.category}><a class="index-entry" href={note.url}>
  {numbered&&<span class="entry-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span>}
  <div class="entry-meta"><span>{note.category}</span><time datetime={note.pubDate.toISOString()}>{dateLabel(note.pubDate)}</time></div>
  <div class="entry-copy"><h2>{note.title}</h2>{note.description&&<p>{note.description}</p>}</div>
  <div class="entry-end"><span class="entry-language">{langLabel(note.language)}</span><span class="entry-arrow" aria-hidden="true">→</span></div>
 </a></li>)}
</ol>
