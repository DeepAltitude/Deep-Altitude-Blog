---
import { dateLabel, type Note } from "../utils/posts";
import { domainNames, topicFor } from "../utils/domains";
interface Props {
  notes: Note[];
  showDomain?: boolean;
  heading?: "h2" | "h3";
}
const { notes, showDomain = true, heading: Heading = "h2" } = Astro.props;
---

<ol class="article-index">
  {notes.map((note) => (
    <li data-domain={note.domain} data-topic={note.topic}>
      <a class="index-entry" href={note.url}>
        <div class="entry-meta">
          <time datetime={note.pubDate.toISOString()}>
            {dateLabel(note.pubDate)}
          </time>
          {showDomain && note.domain && (
            <span>
              {domainNames[note.domain]} ·{" "}
              {topicFor(note.domain, note.topic)?.title}
            </span>
          )}
        </div>
        <div class="entry-copy">
          <Heading>{note.title}</Heading>
          {note.description && <p>{note.description}</p>}
          {note.tags.length > 0 && (
            <p class="entry-tags">{note.tags.join(" · ")}</p>
          )}
        </div>
        <span class="entry-arrow" aria-hidden="true">
          →
        </span>
      </a>
    </li>
  ))}
</ol>
