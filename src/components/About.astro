---
import { getEntry, render } from "astro:content";
import Site from "../layouts/Site.astro";
import AuthorLink from "./AuthorLink.astro";
const page = await getEntry("pages", "about");
if (!page) throw Error("About content missing");
const { Content } = await render(page);
---

<Site
  title={page.data.title}
  description={page.data.description}
  active="About"
  canonical="/apie/"
>
  <article class="reading-page about-page">
    <header class="article-header">
      <p class="eyebrow">DEEP ALTITUDE / APIE</p>
      <h1>{page.data.title}</h1>
    </header>
    <AuthorLink file="src/content/pages/about.md" label="Edit About" />
    <div class="prose" lang={page.data.language}>
      <Content />
    </div>
    <nav class="page-turn">
      <a href="/uzrasai/">Visi užrašai →</a>
    </nav>
  </article>
</Site>
