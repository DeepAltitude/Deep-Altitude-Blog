---
import {copy,homeUrl,aboutUrl,type Edition} from '../utils/posts';
const {edition='original'}=Astro.props as {edition?:Edition};
---
<footer class="site-footer"><a class="footer-wordmark" href={homeUrl(edition)}>deepaltitude <span aria-hidden="true">↗</span></a><p>{copy[edition].footer}</p><div><a href={aboutUrl(edition)}>{copy[edition].about}</a><a href="/rss.xml">RSS</a></div></footer>
