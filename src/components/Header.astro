---
import Logo from './Logo.astro';
import {copy,languages,htmlLang,homeUrl,indexUrl,aboutUrl,type Edition,type Category} from '../utils/posts';
interface Props {edition?:Edition;active?:string;versions?:{edition:Edition;href:string}[]}
const {edition='original',active='',versions=[]}=Astro.props,t=copy[edition];
const links=[{label:'Blog',href:indexUrl(edition),key:'Blog'},...(['Sportas','Kalbos','Protas'] as Category[]).map(c=>({label:c,href:indexUrl(edition,c),key:c})),{label:t.about,href:aboutUrl(edition),key:'About'}];
---
<a href="#main" class="skip-link">{t.skip}</a>
<header class="site-header">
 <a class="wordmark" href={homeUrl(edition)} aria-label="Deep Altitude — Home"><Logo placement="header" /><span><strong>deep</strong>altitude<small>{t.notebook}</small></span></a>
 <nav aria-label={t.notes}>{links.map(l=><a href={l.href} aria-current={active===l.key?'page':undefined}>{l.label}</a>)}</nav>
 {versions.length>1&&<details class="edition-picker"><summary>{languages[edition]}<span aria-hidden="true">⌄</span></summary><div class="edition-menu">{versions.map(v=><a href={v.href} lang={htmlLang[v.edition]} aria-current={edition===v.edition?'true':undefined}>{languages[v.edition]}{edition===v.edition&&<span aria-hidden="true">✓</span>}</a>)}</div></details>}
</header>
<script>
 document.querySelectorAll<HTMLDetailsElement>('.edition-picker').forEach(picker=>{
  document.addEventListener('click',event=>{if(!picker.contains(event.target as Node))picker.open=false;});
  picker.addEventListener('keydown',event=>{if(event.key==='Escape'){picker.open=false;picker.querySelector('summary')?.focus();}});
 });
</script>
