---
import Logo from "./Logo.astro";
interface Props {
  active?: string;
}
const { active = "" } = Astro.props;
---

<a href="#main" class="skip-link">
  Pereiti prie turinio
</a>
<header class="site-header">
  <a class="wordmark" href="/" aria-label="DeepAltitude — Home">
    <Logo placement="header" />
    <span>
      <strong>deep</strong>altitude<small>ASMENINIS UŽRAŠŲ SĄSIUVINIS</small>
    </span>
  </a>
  <nav aria-label="Pagrindinė navigacija">
    <a href="/dabar/" data-author-link hidden>
      Dabar
    </a>
    <a
      href="/projektai/"
      aria-current={active === "Projects" ? "page" : undefined}
    >
      Projektai
    </a>
    <a
      href="/eksperimentai/"
      aria-current={active === "Experiments" ? "page" : undefined}
    >
      Eksperimentai
    </a>
    <a href="/uzrasai/" aria-current={active === "Notes" ? "page" : undefined}>
      Užrašai
    </a>
    <a
      href="/principai/"
      aria-current={active === "Principles" ? "page" : undefined}
    >
      Principai
    </a>
  </nav>
</header>
