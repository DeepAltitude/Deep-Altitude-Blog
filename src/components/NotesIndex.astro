---
import Site from "../layouts/Site.astro";
import NotebookSurface from "./NotebookSurface.astro";
import DomainNav from "./DomainNav.astro";
import { getNotes } from "../utils/posts";
const notes = await getNotes();
---
<Site title="Užrašai" active="Notes" description="Visi užrašai — nuo naujausio." canonical="/uzrasai/">
  <section class="index-page">
    <header class="page-heading"><p class="eyebrow">DEEP ALTITUDE / UŽRAŠAI</p><h1>Užrašai</h1><p class="standfirst">Visi užrašai — nuo naujausio.</p></header>
    <DomainNav />
    <nav class="domain-filter topic-filter" data-topic-filter aria-label="Topics"></nav>
    <NotebookSurface notes={notes} />
  </section>
</Site>
