---
import Site from "../layouts/Site.astro";
import ArticleList from "./ArticleList.astro";
import { topics } from "../utils/domains";
import DomainNav from "./DomainNav.astro";
import { getNotes } from "../utils/posts";
const notes = await getNotes(),
  years = [...new Set(notes.map((note) => note.pubDate.getUTCFullYear()))];
---

<Site
  title="Užrašai"
  active="Notes"
  description="Visi užrašai — nuo naujausio."
  canonical="/uzrasai/"
>
  <section class="index-page">
    <header class="page-heading">
      <p class="eyebrow">DEEP ALTITUDE / UŽRAŠAI</p>
      <h1>Užrašai</h1>
      <p class="standfirst">Visi užrašai — nuo naujausio.</p>
    </header>
    <DomainNav />
    <nav
      class="domain-filter topic-filter"
      data-topic-filter
      aria-label="Temos"
    ></nav>
    <script
      type="application/json"
      id="topic-data"
      set:html={JSON.stringify(topics)}
    />
    <p class="filter-status" role="status" data-filter-status>
      {notes.length} užrašai
    </p>
    {years.map((year) => (
      <section class="year-group" data-year>
        <h2>{year}</h2>
        <ArticleList
          notes={notes.filter((note) => note.pubDate.getUTCFullYear() === year)}
          heading="h3"
        />
      </section>
    ))}
    <p class="empty-index" data-empty-filter hidden>
      Šioje srityje užrašų dar nėra.
    </p>
  </section>
</Site>
<script>
  const nav = document.querySelector<HTMLElement>("[data-domain-filter]");
  if (nav) {
    const apply = () => {
      let domain = new URL(location.href).searchParams.get("domain") || "";
      if (
        !Array.from(
          nav.querySelectorAll<HTMLAnchorElement>("[data-filter]"),
        ).some((link) => link.dataset.filter === domain)
      )
        domain = "";
      const topicNav = document.querySelector<HTMLElement>(
          "[data-topic-filter]",
        )!,
        data = JSON.parse(document.getElementById("topic-data")!.textContent!);
      let topic = new URL(location.href).searchParams.get("topic") || "";
      if (!data[domain]?.some((t: any) => t.id === topic)) topic = "";
      topicNav.replaceChildren();
      if (domain) {
        for (const t of [
          { id: "", title: "Visos temos" },
          ...(data[domain] || []),
        ]) {
          const a = document.createElement("a");
          a.textContent = t.title;
          a.href =
            "/uzrasai/?domain=" + domain + (t.id ? "&topic=" + t.id : "");
          a.dataset.topic = t.id;
          if (t.id === topic) a.setAttribute("aria-current", "page");
          topicNav.appendChild(a);
        }
      }
      let count = 0;
      document
        .querySelectorAll<HTMLElement>(".article-index>li")
        .forEach((row) => {
          row.hidden =
            (!!domain && row.dataset.domain !== domain) ||
            (!!topic && row.dataset.topic !== topic);
          if (!row.hidden) count++;
        });
      nav
        .querySelectorAll<HTMLAnchorElement>("[data-filter]")
        .forEach((link) => {
          if (link.dataset.filter === domain)
            link.setAttribute("aria-current", "page");
          else link.removeAttribute("aria-current");
        });
      document
        .querySelectorAll<HTMLElement>("[data-year]")
        .forEach(
          (group) =>
            (group.hidden = !group.querySelector(
              ".article-index>li:not([hidden])",
            )),
        );
      document.querySelector<HTMLElement>("[data-empty-filter]")!.hidden =
        count > 0;
      document.querySelector("[data-filter-status]")!.textContent =
        count + " užrašai";
    };
    nav.addEventListener("click", (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>(
        "a[data-filter]",
      );
      if (
        !link ||
        (event instanceof MouseEvent &&
          (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey))
      )
        return;
      event.preventDefault();
      history.pushState(null, "", link.href);
      apply();
    });
    document
      .querySelector("[data-topic-filter]")!
      .addEventListener("click", (event) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>(
          "a[data-topic]",
        );
        if (
          !link ||
          (event instanceof MouseEvent &&
            (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey))
        )
          return;
        event.preventDefault();
        history.pushState(null, "", link.href);
        apply();
      });
    window.addEventListener("popstate", apply);
    apply();
  }
</script>
