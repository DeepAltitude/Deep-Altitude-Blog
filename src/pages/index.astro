---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getAllPosts } from '../utils/posts';

const posts = (await getAllPosts()).filter(post => post.id !== 'markdown-style-guide');
const sections = [
  { name: 'Sportas', number: '01', label: 'Kūnas. Rizika. Praktika.', text: 'Laisvasis nardymas, skraidymas, Jiu Jitsu. Ką išmokstu, kai vien suprasti neužtenka.', mark: '↗' },
  { name: 'Kalbos', number: '02', label: 'Mokytis mokytis.', text: 'Kalbų mokymasis, metodai ir kasdienė praktika. Kas man veikia, kas neveikia ir ką keičiu.', mark: '↔' },
  { name: 'Protas', number: '03', label: 'Mintys. Sprendimai. Santykiai.', text: 'Kaip matau situaciją, ko tikiuosi iš kitų ir kuo remiuosi priimdamas sprendimus.', mark: '○' },
];
const formatDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
---
<!doctype html>
<html lang="lt">
  <head>
    <BaseHead title="Deep Altitude — Rašau, kad pats suprasčiau" description="Mano viešas užrašų sąsiuvinis. Rašau, kad išsigryninčiau mintis, užfiksuočiau patirtį ir vėliau galėčiau prie jos grįžti. Sportas, kalbos ir protas." />
  </head>
  <body class="notebook-home">
    <a class="skip-link" href="#main">Pereiti prie turinio</a>
    <Header />
    <main id="main">
      <section class="hero" aria-labelledby="purpose">
        <div class="hero-copy">
          <p class="eyebrow"><span class="dot"></span> Asmeninis užrašų sąsiuvinis</p>
          <h1 id="purpose">Rašau, kad<br />pats <em>suprasčiau.</em></h1>
          <p class="intro">Mintis galvoje dažnai atrodo aiški. Kol nepabandau jos užrašyti.</p>
          <p class="hero-note">Čia dėlioju tai, ką patiriu, mokausi ir galvoju. Rašydamas matau, kur yra esmė, kur tik prielaida, o kur dar pats sau prieštarauju.</p>
          <div class="actions"><a class="button" href="/blog/">Skaityti užrašus <span aria-hidden="true">↗</span></a><a class="quiet-link" href="#kodel">Kodėl rašau <span aria-hidden="true">↓</span></a></div>
        </div>
        <div class="field" aria-hidden="true">
          <div class="field-top"><span>DEEP / ALTITUDE</span><span>UŽRAŠAI IŠ PRAKTIKOS</span></div>
          <svg viewBox="0 0 420 480" fill="none" xmlns="http://www.w3.org/2000/svg">
            <g stroke="currentColor" stroke-width="1">
              <ellipse cx="210" cy="240" rx="182" ry="210" transform="rotate(28 210 240)" />
              <ellipse cx="210" cy="240" rx="158" ry="184" transform="rotate(28 210 240)" />
              <ellipse cx="210" cy="240" rx="134" ry="158" transform="rotate(28 210 240)" />
              <ellipse cx="210" cy="240" rx="110" ry="132" transform="rotate(28 210 240)" />
              <ellipse cx="210" cy="240" rx="86" ry="106" transform="rotate(28 210 240)" />
              <ellipse cx="210" cy="240" rx="62" ry="80" transform="rotate(28 210 240)" />
              <ellipse cx="210" cy="240" rx="38" ry="54" transform="rotate(28 210 240)" />
              <path d="M210 24V456M22 240H398" stroke-dasharray="3 7" opacity=".5" />
            </g>
            <circle cx="210" cy="240" r="6" fill="#e5c99c" />
          </svg>
          <div class="field-bottom"><span>Patirti.<br />Apmąstyti.<br /><strong>Užrašyti.</strong></span><span class="field-index">↗<br />↓</span></div>
        </div>
      </section>
      <section class="purpose-section" id="kodel" aria-labelledby="why-title">
        <div><p class="eyebrow">01 / Paskirtis</p><h2 id="why-title">Pirmiausia —<br />pačiam sau.</h2></div>
        <div class="purpose-text"><p>Šita svetainė yra vieta išsigryninti savo mintis ir jas išsaugoti. Užrašyti, ką išmokau. Ką manau dabar ir kodėl. Po kurio laiko grįžti ir pažiūrėti: ar vis dar taip galvoju? Ką parodė patirtis?</p><p>Rašau apie sportą, kalbų mokymąsi, sprendimus ir santykius. Apie dalykus, kuriuos pats bandau suprasti. Kai kas čia tėra trumpa pastaba. Kai kas — ilgesnis bandymas susidėlioti mintis.</p><p>Palieku vietos persigalvoti. Jei pamatau kitaip, papildau arba perrašau. Noriu matyti, kaip keičiasi mano supratimas.</p><p class="last-thought">Sąsiuvinis viešas. Jei kas nors pravers ir tau — gerai.</p></div>
      </section>
      <section class="sections" aria-labelledby="sections-title">
        <div class="section-heading"><div><p class="eyebrow">02 / Temos</p><h2 id="sections-title">Trys kryptys.</h2></div><span class="subtle">Tas pats smalsumas.</span></div>
        <div class="section-grid">{sections.map(section => <a class="topic" href={`/${section.name}/`}><div class="topic-top"><span>{section.number}</span><span class="topic-mark" aria-hidden="true">{section.mark}</span></div><h3>{section.name}</h3><p class="topic-label">{section.label}</p><p>{section.text}</p><div class="topic-bottom"><span>Įrašų: {posts.filter(p => p.collection === section.name).length}</span><span aria-hidden="true">↗</span></div></a>)}</div>
      </section>
      <section class="recent" aria-labelledby="recent-title">
        <div class="section-heading"><div><p class="eyebrow">03 / Užrašai</p><h2 id="recent-title">Paskutiniai puslapiai.</h2></div><a class="quiet-link" href="/blog/">Visi užrašai <span aria-hidden="true">↗</span></a></div>
        <ol class="post-list">{posts.slice(0, 4).map(post => <li><a href={`/${post.collection}/${post.id}/`}><div class="post-meta"><span>{post.collection === 'blog' ? 'Blog' : post.collection}</span><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></div><div class="post-text"><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="post-arrow" aria-hidden="true">↗</span></a></li>)}</ol>
      </section>
      <div class="closing"><span>DEEP ALTITUDE</span><p>Mintys keičiasi. Užrašai lieka.</p><a href="#main" aria-label="Grįžti į viršų">↑</a></div>
    </main>
    <Footer />
  </body>
</html>
<style>
  :global(body.notebook-home){background:#f6f3eb;color:#233e38;font-size:18px;--accent:#285a4b;--accent-dark:#183d33;--black:28,51,44;--gray:103,113,101;--gray-dark:35,62,56}
  :global(.notebook-home header){background:#f6f3eb;box-shadow:none;border-bottom:1px solid #d9ded2;padding:0 5vw}
  :global(.notebook-home header nav){max-width:1200px;margin:auto;min-height:82px}
  :global(.notebook-home header a){color:#233e38}
  :global(.notebook-home footer){background:#f6f3eb;padding:20px 5vw 35px;font-size:13px;color:#58665e}
  main{width:1200px;max-width:90%;padding:0;margin:auto}
  .eyebrow{font-size:11px;letter-spacing:.15em;text-transform:uppercase;font-weight:700;margin:0 0 28px;display:flex;gap:10px;align-items:center}
  .dot{width:7px;height:7px;background:#52856a;border-radius:50%}
  .hero{display:grid;grid-template-columns:1.35fr 1fr;gap:7%;padding:72px 0 78px;align-items:center}
  h1{font-family:Georgia,serif;font-size:clamp(48px,5.9vw,82px);font-weight:400;line-height:1.08;letter-spacing:-.045em;margin:0 0 28px}
  h1 em{font-weight:400;color:#476f55}
  .intro{font-size:23px;line-height:1.5;max-width:440px;margin:0 0 20px}
  .hero-note{max-width:460px;font-size:17px;color:#536159;line-height:1.75;margin:0}
  .actions{display:flex;align-items:center;gap:28px;flex-wrap:wrap;margin-top:32px}
  .button{background:#23483c;color:#fff;padding:14px 22px;text-decoration:none;font-size:15px;display:inline-flex;gap:28px;align-items:center;border:1px solid #23483c}
  .button:hover{background:#14382b;color:#fff}
  .quiet-link{font-size:14px;text-decoration:none;color:#233e38;display:inline-flex;align-items:center;gap:18px;border-bottom:1px solid #a1ad9d;padding:6px 0}
  .field{background:#193e35;min-height:480px;position:relative;overflow:hidden;color:#658575;padding:26px;box-sizing:border-box;display:flex;flex-direction:column;justify-content:space-between}
  .field svg{position:absolute;width:110%;height:100%;left:-5%;top:0;opacity:.65}
  .field-top,.field-bottom{position:relative;z-index:1;display:flex;justify-content:space-between;gap:20px}
  .field-top{font-size:9px;letter-spacing:.12em;color:#bdc9b6}
  .field-bottom{align-items:end;color:#e9e8d6;font-family:Georgia,serif;font-size:32px;line-height:1.2}
  .field-bottom strong{font-weight:400;color:#e5c99c}
  .field-index{font-family:Arial,sans-serif;font-size:36px;color:#bdc9b6;line-height:1.6}
  .purpose-section{border-top:1px solid #bcc8b9;display:grid;grid-template-columns:1fr 1.35fr;gap:10%;padding:64px 0 74px;scroll-margin-top:25px}
  h2{font-family:Georgia,serif;font-size:clamp(32px,3.5vw,45px);font-weight:400;letter-spacing:-.025em;line-height:1.15}
  .purpose-text p{margin:0 0 20px;line-height:1.8;font-size:18px}
  .purpose-text .last-thought{color:#476f55;margin:26px 0 0;font-family:Georgia,serif;font-style:italic;font-size:22px}
  .sections{padding:56px 0 64px;border-top:1px solid #bcc8b9}
  .section-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:32px}
  .section-heading .eyebrow{margin-bottom:16px}
  .subtle{font-size:14px;color:#637163}
  .section-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .topic{display:flex;flex-direction:column;background:#eeeee3;border:1px solid #d7dcce;padding:26px;color:#233e38;text-decoration:none;transition:background .2s}
  .topic:hover{background:#e2e8da;color:#233e38}
  .topic-top,.topic-bottom{display:flex;justify-content:space-between;align-items:center;font-size:12px}
  .topic-top{margin-bottom:32px;color:#536652}
  .topic-mark{font-size:30px;line-height:1}
  .topic h3{font-family:Georgia,serif;font-size:32px;font-weight:400;margin:0 0 14px}
  .topic p{font-size:15px;line-height:1.7;margin:0 0 22px;color:#536159}
  .topic .topic-label{font-size:14px;color:#233e38;margin-bottom:12px;font-weight:700}
  .topic-bottom{margin-top:auto;padding-top:24px;border-top:1px solid #cdd5c5}
  .topic-bottom span:last-child{font-size:23px}
  .recent{padding:54px 0;border-top:1px solid #bcc8b9}
  .post-list{list-style:none;padding:0;margin:0}
  .post-list li{border-top:1px solid #d2d9cc}
  .post-list li:last-child{border-bottom:1px solid #d2d9cc}
  .post-list a{padding:24px 0;display:grid;grid-template-columns:150px 1fr 30px;gap:28px;align-items:center;text-decoration:none;color:#233e38}
  .post-meta{font-size:11px;letter-spacing:.06em;text-transform:uppercase;display:flex;flex-direction:column;gap:7px}
  .post-meta time{color:#627063;font-size:12px}
  .post-text h3{font-family:Georgia,serif;font-size:25px;font-weight:400;margin-bottom:5px}
  .post-text p{font-size:14px;color:#58665e;margin:0}
  .post-list a:hover h3{text-decoration:underline;text-underline-offset:5px}
  .post-arrow{font-size:24px}
  .closing{display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid #bcc8b9;padding:30px 0}
  .closing>span{font-size:10px;letter-spacing:.15em}
  .closing p{font-family:Georgia,serif;font-style:italic;font-size:20px;margin:0}
  .closing a{font-size:24px;text-decoration:none;padding:5px 14px}
  a:focus-visible{outline:3px solid #aa7635;outline-offset:5px}
  .skip-link{position:absolute;left:16px;top:-100px;background:#fff;padding:10px;z-index:10}.skip-link:focus{top:12px}
  @media(max-width:800px){.hero{gap:5%;padding-top:48px}.field{min-height:420px;padding:20px}.field-top{font-size:8px}.purpose-section{gap:6%;grid-template-columns:1fr 1.5fr}.topic{padding:20px}.section-grid{gap:12px}}
  @media(max-width:600px){main{max-width:88%}.hero{grid-template-columns:1fr;gap:36px;padding:42px 0}.intro{font-size:21px}.field{min-height:300px}.field svg{width:80%;left:30%;transform:rotate(12deg)}.field-top{font-size:9px}.field-bottom{font-size:28px}.purpose-section{grid-template-columns:1fr;gap:28px;padding:38px 0}.purpose-text p{font-size:17px}.eyebrow{margin-bottom:20px}.sections,.recent{padding:36px 0}.section-grid{grid-template-columns:1fr;gap:16px}.topic-top{margin-bottom:20px}.section-heading{align-items:start;flex-wrap:wrap}.post-list a{grid-template-columns:1fr 24px;gap:12px;padding:22px 0}.post-meta{grid-column:1 / -1;flex-direction:row;justify-content:space-between}.post-text h3{font-size:24px}.closing{flex-wrap:wrap}.closing p{order:3;width:100%;font-size:19px}.actions{gap:22px}.field-index{font-size:30px}}
  @media(prefers-reduced-motion:reduce){.topic{transition:none}}
</style>
