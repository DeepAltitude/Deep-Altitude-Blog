---
import Site from "../layouts/Site.astro";
import OperationSurface from "../components/OperationSurface.astro";
import "../styles/calendar.css";
import { authenticate, privateHeaders } from "../server/guard";
export const prerender = false;
for (const [key, value] of Object.entries(privateHeaders))
  Astro.response.headers.set(key, value);
try {
  await authenticate(Astro.request, (Astro.locals.runtime?.env ?? {}) as any);
} catch {
  return Astro.redirect("/editor/?returnTo=%2Fdabar%2F", 303);
}
---

<Site title="Dabar" noindex class="daily-page" canonical="/dabar/">
  <header class="page-heading">
    <p class="eyebrow" id="today-label"></p>
    <h1>Dabar</h1>

  </header>
  <p id="status" role="status" aria-live="polite"></p>
  <section class="notebook-section calendar-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / KALENDORIUS</p>
        <h2>Kalendorius</h2>
      </div>
    </div>
    <div class="calendar-toolbar">
      <div class="calendar-nav">
        <button type="button" id="previous-month" aria-label="Previous month">
          ‹
        </button>
        <button type="button" id="today-month">
          Today
        </button>
        <button type="button" id="next-month" aria-label="Next month">
          ›
        </button>
      </div>
      <label class="calendar-view">
        Show{" "}
        <select id="month-count" aria-label="Number of months">
          <option value="1">1 month</option>
          <option value="3">3 months</option>
          <option value="6">6 months</option>
          <option value="12">12 months</option>
        </select>
      </label>
    </div>
    <div class="calendar-filters" aria-label="Calendar sources">
      <label>
        <input type="checkbox" value="google" checked />
        Google
      </label>
      <label>
        <input type="checkbox" value="project" checked />
        Projektai
      </label>
      <label>
        <input type="checkbox" value="experiment" checked />
        Eksperimentai
      </label>

      <button type="button" id="retry-calendar">
        Refresh
      </button>
      <a href="/editor/?kind=settings">Settings</a>
    </div>
    <p class="muted" id="calendar-status" role="status"></p>
    <div id="months" aria-busy="true"></div>
  </section>
  <section class="notebook-section" data-weekly-focus>
    <p class="eyebrow">02 / WEEKLY FOCUS</p>
    <h2>Weekly focus</h2>
    <div data-current-focus></div>
    <section class="focus-history">
      <h3>Previous weeks</h3>
      <div data-focus-history></div>
      <button type="button" class="quiet-action" data-more-focus hidden>Show more</button>
    </section>
  </section>
  <section class="notebook-section">
    <div class="section-heading"><h2>Projektai</h2><a href="/projektai/">All projects →</a></div>
    <OperationSurface kind="projects" records={[]} current dabar />
  </section>
  <section class="notebook-section">
    <div class="section-heading"><h2>Eksperimentai</h2><a href="/eksperimentai/">All experiments →</a></div>
    <OperationSurface kind="experiments" records={[]} current dabar />
  </section>
  <dialog id="day-dialog" aria-labelledby="day-title">
    <button class="dialog-close" type="button" data-close aria-label="Close">
      ×
    </button>
    <h2 id="day-title"></h2>
    <ul id="day-agenda" class="text-index"></ul>
  </dialog>
  <dialog id="event-dialog" aria-labelledby="event-title">
    <button class="dialog-close" type="button" data-close aria-label="Close">
      ×
    </button>
    <p class="eyebrow" id="event-calendar"></p>
    <h2 id="event-title"></h2>
    <p id="event-when"></p>
    <p id="event-location" class="preserve-lines" hidden></p>
    <p id="event-description" class="preserve-lines" hidden></p>
    <a id="event-google" target="_blank" rel="noopener noreferrer" hidden>
      Open in Google Calendar ↗
    </a>
  </dialog>
</Site>
<script>
  import "../scripts/dabar";
</script>
