---
import Site from "../../layouts/Site.astro";
import OperationSurface from "../../components/OperationSurface.astro";
import { list } from "../../lib/data/store";
export const prerender = false;
const db = (Astro.locals.runtime?.env as any)?.DB;
let records: any[] = [],
  unavailable = false;
try {
  if (db) records = await list(db, "projects", true);
} catch {
  unavailable = true;
  Astro.response.status = 503;
}
Astro.response.headers.set("Cache-Control", "no-cache");
---

<Site title="Projektai" active="Projects" canonical="/projektai/">
  <section class="index-page">
    <header class="page-heading">
      <p class="eyebrow">DEEP ALTITUDE</p>
      <h1>Projektai</h1>
    </header>
    <OperationSurface kind="projects" records={records} />
    {unavailable && (
      <p class="muted">
        {unavailable
          ? "Šiuo metu nepavyko įkelti. Pabandykite vėliau."
          : "Viešų įrašų kol kas nėra."}
      </p>
    )}
  </section>
</Site>
