---
import Site from "../../layouts/Site.astro";
import PrincipleList from "../../components/PrincipleList.astro";
import { getPrinciples } from "../../utils/principles";
const principles=await getPrinciples();
---
<Site title="Principai" description="Bendros pamokos iš patirties skirtingose gyvenimo srityse." active="Principles" canonical="/principai/">
  <section class="index-page">
    <header class="page-heading"><p class="eyebrow">DEEP ALTITUDE / PRINCIPAI</p><h1>Principai</h1><p class="standfirst">Bendros pamokos iš patirties skirtingose gyvenimo srityse.</p></header>
    <section data-notebook data-kind="principle"><header class="inline-heading"><span></span><span data-create-slot></span></header><div data-new-item></div><p data-notebook-status class="inline-status" role="status"></p><div data-notebook-list><PrincipleList principles={principles} /></div><p class="empty-index" data-empty-notebook hidden={principles.length>0}>Čia atsiras principai ir su jais susiję užrašai.</p></section>
  </section>
</Site>
