---
import Site from "../../layouts/Site.astro";
export const prerender = false;
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---
<Site title="Settings" noindex canonical="/editor/" class="settings-page">
  <header class="page-heading"><p class="eyebrow">DEEP ALTITUDE / AUTHOR</p><h1 id="editor-heading">Settings</h1></header>
  <section id="login">
    <p id="login-message" role="status">Checking author sign-in…</p>
    <a id="login-link" href="/api/editor/login" hidden>Sign in with GitHub →</a>
  </section>
  <section id="workspace" hidden>
    <div class="editor-account"><a href="/dabar/">Dabar →</a><button id="logout" class="quiet-action" type="button">Sign out</button></div>
    <nav class="editor-nav" aria-label="Site settings">
      <a href="/editor/?file=src/content/pages/home.md">Home</a>
      <a href="/editor/?file=src/content/pages/about.md">About</a>
      <a href="/editor/?kind=settings">Settings</a>
    </nav>
    <p id="status" role="status" aria-live="polite"></p>
    <div id="page-editor"></div>
    <section id="settings" hidden>
      <h2>Google Calendar</h2><p id="calendar-connection"></p>
      <div class="inline-actions"><a href="/api/calendar/connect" id="calendar-connect" hidden>Connect Google Calendar →</a><button id="calendar-disconnect" class="quiet-action" type="button" hidden>Disconnect</button></div>
      <form id="calendar-settings" class="inline-form" hidden>
        <fieldset id="calendar-choices"><legend>Calendars</legend></fieldset>
        <label>Timezone<input name="timezone" value="Europe/Zurich" required /></label>
        <button type="submit" class="inline-primary">Save</button>
      </form>
      <p class="editor-help">DeepAltitude only reads your selected calendars. Create and manage events in Google Calendar. This connection is separate from your author sign-in.</p>
      <details class="inline-more"><summary>Advanced</summary><p>Notes, principles, projects and experiments are edited where you read them.</p><ul class="text-index"><li><a href="/uzrasai/">Užrašai →</a></li><li><a href="/principai/">Principai →</a></li><li><a href="/projektai/">Projektai →</a></li><li><a href="/eksperimentai/">Eksperimentai →</a></li></ul></details>
    </section>
  </section>
</Site>
<script>import "../../scripts/editor";</script>
