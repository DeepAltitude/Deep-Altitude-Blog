---
import {editions,getNotes} from '../../../utils/posts';
import BlogPost from '../../../layouts/BlogPost.astro';
export async function getStaticPaths(){return (await Promise.all(editions.map(async edition=>(await getNotes(edition)).map(note=>({params:{edition,id:note.id},props:{note}}))))).flat();}
const {note}=Astro.props;
---
<BlogPost note={note}/>
