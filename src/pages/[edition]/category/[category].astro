---
import {editions} from '../../../utils/posts';
import {domains} from '../../../utils/domains';
import NotesIndex from '../../../components/NotesIndex.astro';
export function getStaticPaths(){return editions.flatMap(edition=>[
 ...domains.map(domain=>({params:{edition,category:domain},props:{edition,domain}})),
 {params:{edition,category:'blog'},props:{edition,category:'Blog' as const}},
]);}
---
<NotesIndex {...Astro.props}/>
